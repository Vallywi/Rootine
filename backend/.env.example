# Copy to .env (backend/.env for local use). Never commit the real file.

# Leave DATABASE_URL empty to use a local database in backend/.data (no setup needed).
# For Supabase use the POOLER connection string (Project Settings > Database > Connection pooling).
DATABASE_URL=
DATABASE_SSL=true

PORT=4000
NODE_ENV=development
# Set to 1 on Vercel so the real client IP and HTTPS are detected.
TRUST_PROXY=0
