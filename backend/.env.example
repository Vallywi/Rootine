# Copy to .env (backend/.env for local use). Never commit the real file.

# Leave DATABASE_URL empty to use a local database in backend/.data (no setup needed).
# For Supabase use the POOLER connection string (Project Settings > Database > Connection pooling).
DATABASE_URL=
DATABASE_SSL=true

PORT=4000
NODE_ENV=development
# Set to 1 on Vercel so the real client IP and HTTPS are detected.
TRUST_PROXY=0

# Demo mode (development only): focus and breaks can be 1 minute and every tree is unlocked,
# so you can try growing, collecting, and the yard right away. It is ignored when NODE_ENV=production.
DEMO_MODE=0

# Web Push (optional). Generate keys with: npx web-push generate-vapid-keys. See docs/PUSH-SETUP.md.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=
